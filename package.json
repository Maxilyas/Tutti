{
  "name": "tutti",
  "version": "1.0.0",
  "private": true,
  "description": "Tutti — Puzzle musical : le public déplace les musiciens sur une grille en votant depuis son smartphone.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "local": "vite build && vite preview --port 8787 --strictPort",
    "deploy": "vite build && wrangler deploy",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:charge": "node tests/charge/charge.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22"
  }
}
